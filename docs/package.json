{
	"name": "pragmate-ui-docs",
	"version": "0.0.37",
	"title": "Pragmate UI",
	"description": "Official pragmate ui documentation with description of the components and uses of these",
	"license": "ISC",
	"template": "template/template.json",
	"languages": {
		"default": "en",
		"supported": [
			"en",
			"es"
		]
	},
	"libraries": {
		"imports": [
			"pragmate-ui"
		]
	},
	"modules": {
		"path": "modules"
	},
	"deployment": {
		"distributions": [
			{
				"name": "web",
				"environment": "development",
				"platform": "web",
				"ports": {
					"bundles": 6500
				}
			},
			{
				"name": "web.tsc",
				"environment": "development",
				"platform": "web",
				"ports": {
					"bundles": 6501
				},
				"ts": {
					"compiler": "tsc"
				}
			}
		]
	},
	"static": {
		"includes": [
			"assets"
		]
	},
	"dependencies": {
		"@beyond-js/kernel": "~0.1.8",
		"@beyond-js/local": "~0.1.3",
		"@beyond-js/react-18-widgets": "~0.0.5",
		"@beyond-js/reactive": "^2.1.0",
		"@emotion/css": "^11.11.2",
		"@floating-ui/dom": "^1.7.3",
		"@popperjs/core": "^2.11.8",	
		"clsx": "^2.1.1",
		"framer-motion": "^10.16.4",
		"perfect-scrollbar": "^1.5.5",
		"prism-react-renderer": "^1.3.5",
		"prismjs": "^1.27.0",
		"react-aria": "^3.42.0",
		"react-popper": "^2.3.0",
		"react-stately": "^3.40.0",
		"swiper": "^10.3.0",
		"tinycolor2": "^1.6.0",
		"tippy.js": "^6.3.7"
	},
	"overrides": {
		"react": "18.2.0",
		"react-dom": "18.2.0"
	},
	"devDependencies": {
		"@beyond-js/local": "~0.1.3",
		"@mdx-js/mdx": "^2.3.0",
		"@mdx-js/react": "^2.3.0",
		"@types/node": "^20.14.6",
		"@types/react": "^18.0.26",
		"@types/react-dom": "^18.0.9",
		"mdx-bundler": "^9.2.1"
	}
}
